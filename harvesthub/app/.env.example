# Local development: copy this file to .env and fill in your DEVELOPMENT
# project's values. Production builds don't read .env — their values live in
# EAS environment variables (expo.dev -> your project -> Environment
# variables -> "production"); see LAUNCH_ANDROID.md.

# Supabase -> Project Settings -> API. The anon / publishable key is safe to
# ship in the app — it only works within the row-level security policies.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend base URL. For on-device development use your computer's
# LAN IP (find it with `ipconfig`), not localhost. Production must be https.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8000/api/v1

# Stripe -> Developers -> API keys (pk_test_... here, pk_live_... in production)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional: where /privacy, /terms and /delete-account are hosted. Defaults
# to the API's own address (the backend serves them).
# EXPO_PUBLIC_LEGAL_BASE_URL=https://harvesthubmarket.com
