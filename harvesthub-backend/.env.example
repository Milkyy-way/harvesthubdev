# HarvestHub API configuration. Copy to .env for local development; in
# production set these as environment variables on your host instead.

# Supabase -> Project Settings -> Database -> Connection string (use the
# pooler / "Session" URI). Production must point at the PRODUCTION project.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase -> Project Settings -> API keys -> secret (service_role) key.
# Server only — never put this in the app. Needed for account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe -> Developers -> API keys (sk_test_... in development, sk_live_... in production)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe -> Developers -> Webhooks -> your endpoint
# (https://<your-api-domain>/api/v1/webhooks/stripe) -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# production | development (production hides /docs)
ENVIRONMENT=development
# Browser origins allowed to call the API, comma-separated. The mobile app
# doesn't need CORS. In production, list your website or leave it empty.
CORS_ORIGINS=*

# Shown on the public /privacy, /terms and /delete-account pages.
COMPANY_NAME=HarvestHub
SUPPORT_EMAIL=support@harvesthubmarket.com
LEGAL_EFFECTIVE_DATE=October 31, 2026
# Lets a tapped pod invite link open the iPhone app directly. Apple Developer ->
# Membership details -> Team ID. Not secret.
# APPLE_TEAM_ID=ABCDE12345

# --- Notifications (all optional — each channel stays off until its key is set)
# Email: Resend -> API Keys. EMAIL_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=HarvestHub <no-reply@harvesthubmarket.com>
# Text messages: Telnyx -> API Keys, and your Telnyx number in +1XXXXXXXXXX form.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Push: only if you turn on "enhanced push security" at expo.dev -> Access tokens.
EXPO_ACCESS_TOKEN=
# Any long random string. Cloud Scheduler sends it to POST /internal/jobs/run
# (reminders, approval and payout notices). Leave empty to disable that endpoint.
CRON_SECRET=

# Google Maps Platform API key (Google Cloud -> APIs & Services -> Credentials),
# restricted to "Places API (New)" and "Geocoding API". Server only — the app
# gets address suggestions through this API. Empty = no suggestions, and the
# free Census/ZIP lookups (less exact).
GOOGLE_MAPS_API_KEY=

# Where the shared link /app sends people (Invite friends). Set IOS_APP_URL to
# the App Store link once the iPhone app is published.
# ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.harvesthubmarket.app
IOS_APP_URL=
